<!-- views/admin/carrers.ejs -->

<% layout("layouts/admin2") %>

<main class="main-content"> <div class="container-fluid">
<!-- PAGE HEADER -->
<h3 class="mb-4">
  <a href="/admin/academic">
    <i class="fa fa-book me-2"></i>
    Gestión Académica
  </a>
  / Carreras
</h3>
    <div class="alert d-none" role="alert" id="alertMessage">
                A simple danger alert—check it out!
            </div>

<div class="row">

  <!-- ========================= -->
  <!-- FORMULARIO -->
  <!-- ========================= -->
  <div class="col-lg-4 col-md-5 mb-4">

    <div class="card">

      <div class="card-header">
        <h6 class="mb-0" id="cardTitle">
          <i class="fa fa-plus me-2"></i>
          Nuevo Alumno
        </h6>
      </div>
      
      <div class="card-body">

        

        <form method="POST" action="/carrers">
            
          <input type="hidden" name="" id="studentId">

          <div class="mb-3">

            <label for="name" class="form-label">
              Nombre
            </label> 
            <input
              type="text"
              id="nombre"
              name="nombre"
              class="form-control"
              placeholder="Ingrese el nombre ..."
              required
            >
          </div>

          <div class="mb-3">

            <label for="name" class="form-label">
              Apellido
            </label>

            <input
              type="text"
              id="apellido"
              name="apellido"
              class="form-control"
              placeholder="Ingrese el apellido ..."
              required
            >

          </div>

          <div class="mb-3">

            <label for="name" class="form-label">
              Carrera
            </label>

            <input
              type="text"
              id="carrera"
              name="carrera"
              class="form-control"
              placeholder="Ingrese la carrera ..."
              required
            >

          </div>

          <div class="mb-3">

            <label for="name" class="form-label">
              Edad
            </label>

            <input
              type="text"
              id="edad"
              name="edad"
              class="form-control"
              placeholder="Ingrese la edad ..."
              required
            >

          </div>


          <div class="d-flex justify-content-end gap-2">

            <button
              class="btn btn-outline-secondary"
              onclick="limpiar(event)"
            >
              <i class="fa fa-refresh me-1"></i>
              Limpiar
          </button>

            <button
              type="submit"
              class="btn btn-success"
              id="btnGuardar"
              onclick="agregar(event)"
            >
              <i class="fa fa-save me-1"></i>
              Guardar
            </button>

          </div>

        </form>

      </div>

    </div>

  </div>


  <!-- ========================= -->
  <!-- LISTADO -->
  <!-- ========================= -->
  <div class="col-lg-8 col-md-7 mb-4">

    <div class="card">
       
      <div class="card-header">
        <h6 class="mb-0">
          <i class="fa fa-list me-2"></i>
          Lista de Alumnos
        </h6>
      </div>


      <div class="card-body">

        <!-- HEADER ACTIONS -->
        <div class="d-flex justify-content-between align-items-center mb-3">

          <div class="text-muted">
            <i class="fa fa-graduation-cap me-1"></i>
            Alumnos registradas
          </div>

          <div>
            <a
              href="/carrers/new"
              class="btn btn-success"
            >
              <i class="fa fa-plus"></i>
              Agregar Registro
            </a>
          </div>

        </div>


        <!-- TABLE -->
        <div class="table-responsive">

          <table class="table table-striped table-hover" id="tablestudents">

            <thead>
              <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Carrera</th>
                <th>Edad</th>
                <th class="text-end">Acciones</th>
              </tr>
            </thead>


            <tbody>

              <% if ( students && students.length > 0) { %>

                <% for (const student of students) { %>

                  <tr>

                    <td>
                      <%= student.id %>
                    </td>

                    <td>
                      <%= student.nombre %>
                    </td>
                    <td>
                        <%= student.apellido  %>
                    </td>
                    <td>
                        <%= student.carrera %>
                    </td>
                    <td>
                        <%= student.edad %>
                    </td>

                    <td class="text-end">

                      <button
                        class="btn btn-sm btn-outline-secondary me-1"
                        onclick="editar(<%= student.id %>, event)"
                      >
                        <i class="fa fa-edit" ></i>
                        Editar
                    </button>

                      <button
                        class="btn btn-sm btn-outline-danger"
                        onclick="eliminar(<%= student.id %>, event)"
                      >
                        <i class="fa fa-trash"></i>
                        Eliminar
                    </button>

                    </td>

                  </tr>

                <% } %>

              <% } else { %>

                <tr>
                  <td colspan="5" class="text-center text-muted py-4">
                    No se encontraron alumnos
                  </td>
                </tr>

              <% } %>

            </tbody>

          </table>

        </div>

      </div>

    </div>

  </div>

</div>

</div> </main>

<script>
    let studentsRows = document.getElementById("tablestudents").children[1].children.length;

    function limpiar(event){
      event.preventDefault();
      document.getElementById("studentId").value="";
      document.getElementById("nombre").value = "";
      document.getElementById("apellido").value = "";
      document.getElementById("carrera").value = "";
      document.getElementById("edad").value = "";
      document.getElementById("cardTitle").innerHTML = "Nueva Carrera";
    }

    function agregar(event){
        event.preventDefault();

        let nombre = document.getElementById("nombre").value;
        let apellido = document.getElementById("apellido").value;
        let carrera = document.getElementById("carrera").value;
        let edad = document.getElementById("edad").value;
        let tablestudents = document.getElementById("tablestudents");
        let studentId = document.getElementById("studentId").value;

        if(nombre=="" && apellido=="" && carrera=="" && edad==""){
            alertMessage.classList.remove("d-none");
            alertMessage.innerHTML = "Debe llenar todos los campos";
            alertMessage.classList.add("alert-danger");
            alertMessage.classList.remove("alert-success");
        } else {
            if(nombre==""){
             alertMessage.classList.remove("d-none");
             alertMessage.innerHTML = "Debe llenar todos los campos";
             alertMessage.classList.add("alert-danger");
             alertMessage.classList.remove("alert-success");
            } else if (apellido==""){
             alertMessage.classList.remove("d-none");
            alertMessage.innerHTML = "Debe llenar todos los campos";
            alertMessage.classList.add("alert-danger");
            alertMessage.classList.remove("alert-success");
 
            } else if (carrera ==""){
                alertMessage.classList.remove("d-none");
                alertMessage.innerHTML = "Debe llenar todos los campos";
                alertMessage.classList.add("alert-danger");
                alertMessage.classList.remove("alert-success");
            } else if (edad<16 || edad>100){
                alertMessage.classList.remove("d-none");
                alertMessage.innerHTML = "La edad debe de estar entre 16 y 100 años";
                alertMessage.classList.add("alert-danger");
                alertMessage.classList.remove("alert-success");
            }
            else{
               if(studentId==""){
                let tr = document.createElement("TR");
                let td1 = document.createElement("TD");
                let td2 = document.createElement("TD"); 
                let td3 = document.createElement("TD"); 
                let td4 = document.createElement("TD"); 
                let td5 = document.createElement("TD"); 
                
                studentsRows = studentsRows + 1;
                td1.innerHTML = studentsRows;
                td2.innerHTML = nombre;
                td3.innerHTML = apellido;
                td4.innerHTML = carrera;
                td5.innerHTML = edad;
                
                tr.appendChild(td1);
                tr.appendChild(td2);
                tr.appendChild(td3);
                tr.appendChild(td4);
                tr.appendChild(td5);


                tablestudents.children[1].appendChild(tr);

                    alertMessage.classList.remove("d-none");
                    alertMessage.innerHTML = "Alumno resgistrado correctamente";
                    alertMessage.classList.remove("alert-danger");
                    alertMessage.classList.add("alert-success");

                }else{
                let tbody = tablestudents.children[1];

                for (let tr of tbody.children) {  
                    if(tr.children[0].innerHTML.trim() == studentId){
                    tr.children[1].innerHTML = nombre;
                    tr.children[2].innerHTML = apellido;
                    tr.children[3].innerHTML = carrera;
                    tr.children[4].innerHTML = edad;

                    alertMessage.classList.remove("d-none");
                    alertMessage.innerHTML = "Alumno editado correctamente";
                    alertMessage.classList.remove("alert-danger");
                    alertMessage.classList.add("alert-success");

                    document.getElementById("studentId").value="";
                    document.getElementById("nombre").value = "";
                    document.getElementById("apellido").value = "";
                    document.getElementById("carrera").value = "";
                    document.getElementById("edad").value = "";
                    document.getElementById("cardTitle").innerHTML = "Nuevo Alumno";
                    }
                }
                } 
            }

            



        }

        
    }

    function eliminar(id, event){
        let tr = event.currentTarget.parentElement.parentElement;
        tr.remove();
        alertMessage.classList.remove("d-none");
        alertMessage.innerHTML = "Se eliminó correctamente el alumno";
        alertMessage.classList.remove("alert-danger");
        alertMessage.classList.add("alert-success");
    }


    function editar(id, event){
        let tr = event.currentTarget.parentElement.parentElement;
        let idRow = tr.children[0].innerHTML;
        let nombre = tr.children[1].innerHTML;
        let apellido = tr.children[2].innerHTML;
        let carrera = tr.children[3].innerHTML;
        let edad = tr.children[4].innerHTML;

        document.getElementById("cardTitle").innerHTML = "Editar Carrera";

        document.getElementById("nombre").value = nombre.trim();
        document.getElementById("apellido").value = apellido.trim();
        document.getElementById("carrera").value = carrera.trim();
        document.getElementById("edad").value = edad.trim();

        document.getElementById("studentId").value = id;
    }
</script>